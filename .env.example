# HubSpot Configuration
HUBSPOT_API_KEY=your_hubspot_api_key_here

# Microsoft Dynamics 365 CRM Configuration
DYNAMICS_INSTANCE_URL=https://yourorg.crm.dynamics.com
DYNAMICS_ACCESS_TOKEN=your_dynamics_access_token_here

# Microsoft Dynamics 365 Finance & Operations Configuration
D365_FO_INSTANCE_URL=https://yourorg.operations.dynamics.com
D365_FO_ACCESS_TOKEN=your_d365_fo_access_token_here
D365_FO_DATA_AREA=usrt

# Azure AD Configuration (for generating Dynamics tokens)
# Get these from Azure Portal > App Registrations
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret

# Sync Configuration
SYNC_LOOKBACK_MINUTES=60

# Dashboard Server
PORT=3001
